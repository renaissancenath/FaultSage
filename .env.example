# FaultSage Cloud configuration. Copy to .env and fill in. Never commit .env.

# production | staging | development
FAULTSAGE_ENV=production
# 32+ random bytes. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
FAULTSAGE_SECRET_KEY=
# Public address, https in production. Cookies are Secure only over https.
FAULTSAGE_BASE_URL=https://faultsage.example.com
FAULTSAGE_SUPPORT_EMAIL=
FAULTSAGE_ALLOW_SIGNUP=true

# Legal details shown on /terms, /privacy and /refunds. Required before you take payments
# (Consumer Protection (E-Commerce) Rules 2020, IT Rules: seller identity and a grievance officer).
FAULTSAGE_OPERATOR_NAME=
FAULTSAGE_OPERATOR_ADDRESS=
FAULTSAGE_GRIEVANCE_OFFICER=
FAULTSAGE_GRIEVANCE_EMAIL=
FAULTSAGE_JURISDICTION_CITY=
FAULTSAGE_HOSTING_REGION=

# docker compose only
FAULTSAGE_DOMAIN=faultsage.example.com
POSTGRES_PASSWORD=

# Hosted Postgres (Render + Neon). Leave empty with docker compose.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Email (verification, password reset, invites, new-error alerts). Any SMTP server works.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FaultSage <no-reply@example.com>

# Optional "Continue with GitHub". Create an OAuth app at github.com/settings/developers with
# callback URL {FAULTSAGE_BASE_URL}/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Billing (DECISIONS.md Q-004). "none" keeps the Free plan only.
BILLING_PROVIDER=none
LEMONSQUEEZY_CHECKOUT_URL=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Proxies in front of the app that add to X-Forwarded-For (Caddy in docker-compose: 1;
# add 1 for Cloudflare or another CDN in front). Used for rate limits; see D-031.
FAULTSAGE_PROXY_HOPS=1
