{
  "name": "faultsage-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "biome check src",
    "format": "biome format --write src",
    "test": "vitest run",
    "screens": "node e2e/screens.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.18.5",
    "@xyflow/react": "12.3.6",
    "@phosphor-icons/react": "2.1.7"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "vite": "6.4.5",
    "@vitejs/plugin-react": "4.7.0",
    "vitest": "4.1.12",
    "jsdom": "25.0.1",
    "@testing-library/react": "16.1.0",
    "@testing-library/dom": "10.4.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@biomejs/biome": "1.9.4",
    "@fontsource/ibm-plex-sans": "5.1.0",
    "@fontsource/ibm-plex-mono": "5.1.0",
    "axe-core": "4.10.2"
  }
}
